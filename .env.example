# Referencia de configuración local. La aplicación no carga este archivo automáticamente.
# No contiene credenciales ni secretos.
# Recuperación local de emergencia: deshabilitada en el flujo federado normal.
# Sólo configura estas variables si se habilita explícitamente dicha recuperación.
AGENTE_JIRA_EMERGENCY_LOCAL_AUTH_ENABLED=false
AGENTE_JIRA_LOCAL_USER=admin@agentejira.local
AGENTE_JIRA_LOCAL_PASSWORD=

# Producción detrás de HTTPS. Debe coincidir exactamente con la URL registrada
# en la aplicación OAuth de Atlassian. Si se define, se usa como respaldo para
# construir /api/integrations/atlassian/callback.
AGENTE_JIRA_PUBLIC_BASE_URL=https://jira.ejemplo.com
AGENTE_JIRA_ATLASSIAN_CALLBACK_URL=https://jira.ejemplo.com/api/integrations/atlassian/callback
# Endpoint compatible con el catálogo Jira usado por la aplicación. Sólo define
# esta variable si tu organización indica un endpoint distinto.
AGENTE_JIRA_ATLASSIAN_MCP_URL=https://mcp.atlassian.com/v1/mcp/authv2
# Proxy corporativo opcional para las llamadas salientes a Atlassian MCP.
# Ejemplo: http://proxy.empresa.local:8080
AGENTE_JIRA_ATLASSIAN_PROXY_URL=
# Permite que cada identidad Atlassian válida cree su usuario local al primer login.
AGENTE_JIRA_ALLOW_ALL_CORPORATE_USERS=true

VOICE_STT_ENABLED=false
VOICE_WHISPER_MODEL=small
VOICE_WHISPER_LANGUAGE=es
VOICE_WHISPER_DEVICE=cpu
VOICE_WHISPER_COMPUTE_TYPE=int8
VOICE_WHISPER_BEAM_SIZE=2
VOICE_WHISPER_HOTWORDS=Vic Jira genera nueva propuesta confirmación autenticación tarea Task Story Bug Epic Subtask Héctor Víctor prioridad responsable asígnala envíala

VOICE_AI_ENABLED=false
VOICE_LLM_PROVIDER=ollama
VOICE_GEMMA_MODEL=gemma3:1b
OLLAMA_BASE_URL=http://127.0.0.1:11434

VOICE_MAX_AUDIO_BYTES=10485760
VOICE_MAX_DURATION_SECONDS=30
VOICE_COMMAND_TIMEOUT_SECONDS=60
VOICE_MIN_CONFIDENCE=0.70
VOICE_CONTEXT_TTL_SECONDS=1800
VOICE_JIRA_CONFIRMATION_TTL_SECONDS=600

VOICE_TTS_ENABLED=false
VOICE_TTS_PROVIDER=piper
VOICE_TTS_VOICE=es_MX-ald-medium
VOICE_TTS_MODEL_PATH=backend/data/voices/es_MX-ald-medium.onnx
VOICE_TTS_LENGTH_SCALE=1.0
# Sólo se usa cuando VOICE_TTS_PROVIDER=sapi5 en Windows.
VOICE_TTS_RATE=0
VOICE_TTS_TIMEOUT_SECONDS=10
VOICE_TTS_MAX_CHARS=500

# GATE G1: independent from voice. No model is downloaded or selected automatically.
MINUTES_AI_ENABLED=true
MINUTES_LLM_MODEL=qwen3.5:4b
MINUTES_PROMPT_VERSION=minutes_semantic_v1
MINUTES_MAX_CHARS=30000
MINUTES_TIMEOUT_SECONDS=120
MINUTES_ENRICHMENT_MODEL=qwen3.5:4b
MINUTES_ENRICHMENT_TIMEOUT_SECONDS=30
# Reuses OLLAMA_BASE_URL; minutes only accepts loopback URLs.

# Radar IA: enlace opcional y seguro a Telegram. No integra Agente Jira con
# ningún otro servicio, API, base de datos ni agente.
NEWS_TELEGRAM_URL=
