{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interno.example/schemas/jira-proposal-v1.schema.json",
  "title": "Propuesta controlada de work items Jira",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposal_id",
    "version",
    "template_version",
    "status",
    "source_file",
    "defaults",
    "items"
  ],
  "properties": {
    "proposal_id": { "type": "string", "format": "uuid" },
    "version": { "type": "integer", "minimum": 1 },
    "template_version": { "const": "1.0" },
    "status": {
      "enum": [
        "UPLOADED",
        "NORMALIZED",
        "NEEDS_INPUT",
        "DRAFT",
        "VALIDATED",
        "APPROVED",
        "EXECUTING",
        "PARTIAL_SUCCESS",
        "COMPLETED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "source_file": { "$ref": "#/$defs/sourceFile" },
    "defaults": { "$ref": "#/$defs/defaults" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/item" }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "created_by": { "type": "string", "minLength": 1 },
    "approved_at": { "type": ["string", "null"], "format": "date-time" },
    "approved_by": { "type": ["string", "null"] }
  },
  "$defs": {
    "sourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["space"],
      "properties": {
        "space": { "enum": ["AT", "ASIT", "MTTI"] },
        "iniciativa": { "type": ["string", "null"] },
        "linea_trabajo": { "type": ["string", "null"] },
        "sprint": { "type": ["string", "null"] },
        "tipo_seguimiento": { "type": ["string", "null"] },
        "semaforo": { "type": ["string", "null"] }
      }
    },
    "sourceRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_row", "actividad", "responsable_display", "estado_actual"],
      "properties": {
        "source_row": { "type": "integer", "minimum": 6 },
        "actividad": { "type": "string", "minLength": 1 },
        "responsable_display": { "type": "string", "minLength": 1 },
        "grupo_modulo": { "type": ["string", "null"] },
        "contexto_resultado": { "type": ["string", "null"] },
        "fecha_objetivo": { "type": ["string", "null"], "format": "date" },
        "estado_actual": {
          "enum": ["Pendiente", "En curso", "En pausa", "Completada", "Rechazada", "Por confirmar"]
        },
        "comentarios": { "type": ["string", "null"] }
      }
    },
    "jiraFields": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "iniciativa": { "type": ["string", "null"] },
        "linea_trabajo": { "type": ["string", "null"] },
        "sprint": { "type": ["string", "null"] },
        "tipo_seguimiento": { "type": ["string", "null"] },
        "semaforo": { "type": ["string", "null"] },
        "due_date": { "type": ["string", "null"], "format": "date" }
      }
    },
    "generated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "create_in_jira",
        "decision",
        "decision_reason",
        "work_type",
        "title",
        "description",
        "space",
        "fields",
        "confidence"
      ],
      "properties": {
        "row_id": { "type": "string", "pattern": "^ROW-[0-9]{4,}$" },
        "create_in_jira": { "type": "boolean" },
        "decision": { "enum": ["INCLUIR", "REVISAR", "EXCLUIR"] },
        "decision_reason": { "type": "string", "minLength": 1 },
        "work_type": { "enum": ["Epic", "Story", "Task", "Bug", "Subtask"] },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "space": { "enum": ["AT", "ASIT", "MTTI"] },
        "parent_row_id": { "type": ["string", "null"], "pattern": "^ROW-[0-9]{4,}$" },
        "assignee": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["display_name", "account_id"],
          "properties": {
            "display_name": { "type": "string", "minLength": 1 },
            "account_id": { "type": "string", "minLength": 1 }
          }
        },
        "fields": { "$ref": "#/$defs/jiraFields" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["errors", "warnings"],
      "properties": {
        "errors": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_modified", "approved"],
      "properties": {
        "user_modified": { "type": "boolean" },
        "approved": { "type": "boolean" },
        "review_note": { "type": ["string", "null"] }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "idempotency_key": { "type": "string", "minLength": 1 },
        "jira_issue_key": { "type": ["string", "null"] },
        "result": { "enum": ["NOT_STARTED", "CREATED", "SKIPPED", "FAILED"] },
        "error_code": { "type": ["string", "null"] }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "generated", "validation", "review", "execution"],
      "properties": {
        "source": { "$ref": "#/$defs/sourceRow" },
        "generated": { "$ref": "#/$defs/generated" },
        "validation": { "$ref": "#/$defs/validation" },
        "review": { "$ref": "#/$defs/review" },
        "execution": { "$ref": "#/$defs/execution" }
      }
    }
  }
}
